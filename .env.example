# === DayOne Server Configuration ===

# Node environment: development | production
NODE_ENV="development"

# Server port
PORT=3001

# Frontend URL (for CORS) — set to your Vercel domain in production
CORS_ORIGIN="http://localhost:3000"
# CORS_ORIGIN="https://your-app.vercel.app"   ← production

# === Database ===
# Path to SQLite persistent volume (production only — Render disk mount)
# DATA_DIR="/data"   ← set this on Render; leave blank for local dev

# === Clerk Authentication ===
# Development keys (from https://dashboard.clerk.com)
VITE_CLERK_PUBLISHABLE_KEY=pk_test_...
CLERK_SECRET_KEY=sk_test_...
CLERK_WEBHOOK_SECRET=whsec_...
# Production keys — replace pk_test_/sk_test_ with pk_live_/sk_live_ before deploying

# === Frontend API URL (Vite env var — set in Vercel dashboard) ===
# Leave blank in development (Vite proxy handles /api → localhost:3001)
# VITE_API_URL="https://your-api.onrender.com"   ← production

# === AI Configuration ===
# Primary AI provider (Gemini): https://aistudio.google.com/apikey
GEMINI_API_KEY="your_gemini_api_key"

# Fallback AI provider (Groq): https://console.groq.com/keys
GROQ_API_KEY="gsk_your_groq_api_key"
