{
  "name": "dayone",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --port=3000 --host=0.0.0.0",
    "server": "tsx watch server.ts",
    "dev:all": "concurrently -n frontend,backend -c cyan,yellow \"npm run dev\" \"npm run server\"",
    "build": "vite build",
    "build:server": "tsc -p tsconfig.server.json",
    "start": "node dist-server/server.js",
    "preview": "vite preview",
    "clean": "rm -rf dist dist-server",
    "lint": "tsc --noEmit",
    "seed": "tsx src/server/seed.ts",
    "seed:prod": "node dist-server/src/server/seed.js",
    "expo:start": "npx expo start",
    "expo:android": "npx expo start --android",
    "expo:ios": "npx expo start --ios"
  },
  "dependencies": {
    "@babel/core": "^7.26.0",
    "@clerk/clerk-react": "^5.61.4",
