{
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "framework": "vite",
  "installCommand": "npm install",
  "rewrites": [
    { "source": "/__clerk/:path*", "destination": "https://clerk.dayone-navy.vercel.app/:path*" },
    { "source": "/(.*)", "destination": "/index.html" }
  ]
}
